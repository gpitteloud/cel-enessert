      "targets": [
        {
          "datasource": {
            "type": "questdb-questdb-datasource",
            "uid": "QuestDB"
          },
          "format": 1,
          "queryType": "sql",
          "meta": {},
          "rawSql": "SELECT 100 * cast(sum(case when segment = 'cel' then value end) AS DOUBLE)\n           / cast(sum(case when segment = 'total' then value end) AS DOUBLE) AS \"Self-Sufficiency Rate (CEL Local %)\"\nFROM cel_community_energy\nWHERE $__timeFilter(ts)\n  AND community_id = '101110-002726'\n  AND direction = 'consumption'\n  AND segment in ('cel', 'total')",
          "refId": "A",
          "selectedFormat": 1
        }
      ],
      "title": "Self-Sufficiency Rate (CEL Local %)",
      "type": "gauge",
      "description": "Ratio of summed kWh over the dashboard's time range. sum(value) is the plain total: cel_energy holds kWh per 15-min slot, a quantity that falls as well as rises, so it must never be treated as a counter. Gauges need format: TABLE and a query returning exactly one row -- a bucketed query would be reduced with lastNotNull and report the newest bucket instead of the range total. Local consumption over total consumption."
    },
