          "format": 0,
          "queryType": "sql",
          "meta": {},
          "rawSql": "SELECT ts AS time, cast(avg(slot_diff) * 4 AS DOUBLE) AS \"Consumption: E31 - Sum(E66)\"\nFROM (\n  SELECT ts, sum(v) AS slot_diff\n  FROM (\n    SELECT ts, value AS v\n    FROM cel_community_energy\n    WHERE $__timeFilter(ts)\n      AND community_id = '101110-002726'\n      AND segment = 'total'\n      AND direction = 'consumption'\n    UNION ALL\n    SELECT ts, value * -1 AS v\n    FROM cel_energy\n    WHERE $__timeFilter(ts)\n      AND community_id = '101110-002726'\n      AND segment = 'total'\n      AND direction = 'consumption'\n    ORDER BY ts\n  ) timestamp(ts)\n  SAMPLE BY 15m\n)\nSAMPLE BY $__sampleByInterval FILL(NULL)\nORDER BY time",
          "refId": "A",
          "selectedFormat": 0
        },
        {
          "datasource": {
            "type": "questdb-questdb-datasource",
            "uid": "QuestDB"
          },
          "format": 0,
          "queryType": "sql",
          "meta": {},
          "rawSql": "SELECT ts AS time, cast(avg(slot_diff) * 4 AS DOUBLE) AS \"Production: E31 - Sum(E66)\"\nFROM (\n  SELECT ts, sum(v) AS slot_diff\n  FROM (\n    SELECT ts, value AS v\n    FROM cel_community_energy\n    WHERE $__timeFilter(ts)\n      AND community_id = '101110-002726'\n      AND segment = 'total'\n      AND direction = 'production'\n    UNION ALL\n    SELECT ts, value * -1 AS v\n    FROM cel_energy\n    WHERE $__timeFilter(ts)\n      AND community_id = '101110-002726'\n      AND segment = 'total'\n      AND direction = 'production'\n    ORDER BY ts\n  ) timestamp(ts)\n  SAMPLE BY 15m\n)\nSAMPLE BY $__sampleByInterval FILL(NULL)\nORDER BY time",
          "refId": "B",
          "selectedFormat": 0
        }
      ],
      "title": "Validation Difference (E31 - E66) - Should be close to zero",
      "type": "timeseries",
      "interval": "15m",
      "description": "E31 aggregate minus the sum of E66 meters, per 15-min slot. Expressed as one UNION ALL with the E66 side negated so a single sum() per slot gives the difference; ORDER BY ts + timestamp(ts) re-declare the designated timestamp that UNION ALL drops and SAMPLE BY needs."
    }
