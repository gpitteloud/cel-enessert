          "rawSql": "SELECT 100 * cast(sum(case when segment = 'grid' then value end) AS DOUBLE)\n           / cast(sum(case when segment = 'total' then value end) AS DOUBLE) AS \"Grid Dependency (Grid %)\"\nFROM cel_community_energy\nWHERE $__timeFilter(ts)\n  AND community_id = '101110-002726'\n  AND direction = 'consumption'\n  AND segment in ('grid', 'total')",
          "refId": "A",
