      "targets": [
        {
          "datasource": {
            "type": "questdb-questdb-datasource",
            "uid": "QuestDB"
          },
          "editorMode": "code",
          "format": "time_series",
          "meta": {
            "promql": "(avg_over_time(cel_energy_kwh{segment=\"cel\", direction=\"consumption\", meter_id=~\".*${meter_id}\"}[$__interval:15m])) * 4"
          },
          "queryType": "sql",
          "rawSql": "SELECT ts AS time, avg(slot_kwh) * 4 AS \"From CEL\"\nFROM (\n  SELECT ts, sum(value) AS slot_kwh\n  FROM cel_energy\n  WHERE $__timeFilter(ts)\n    AND segment = 'cel'\n    AND direction = 'consumption'\n    AND meter_id LIKE '%$meter_id'\n  SAMPLE BY 15m\n)\nSAMPLE BY $__sampleByInterval FILL(NULL)\nORDER BY time",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "questdb-questdb-datasource",
            "uid": "QuestDB"
          },
          "editorMode": "code",
          "format": "time_series",
          "hide": false,
          "meta": {
            "promql": "(avg_over_time(cel_energy_kwh{segment=\"grid\", direction=\"consumption\", meter_id=~\".*${meter_id}\"}[$__interval:15m])) * 4"
          },
          "queryType": "sql",
          "rawSql": "SELECT ts AS time, avg(slot_kwh) * 4 AS \"From Grid\"\nFROM (\n  SELECT ts, sum(value) AS slot_kwh\n  FROM cel_energy\n  WHERE $__timeFilter(ts)\n    AND segment = 'grid'\n    AND direction = 'consumption'\n    AND meter_id LIKE '%$meter_id'\n  SAMPLE BY 15m\n)\nSAMPLE BY $__sampleByInterval FILL(NULL)\nORDER BY time",
          "refId": "B"
        }
      ],
      "title": "Daily Consumption - ${meter_id}",
      "type": "timeseries",
      "interval": "15m"
    }
  ],
