          "format": 0,
          "meta": {},
          "queryType": "sql",
          "rawSql": "SELECT ts AS time, cast(avg(slot_kwh) * 4 AS DOUBLE) AS \"From CEL\"\nFROM (\n  SELECT ts, sum(value) AS slot_kwh\n  FROM cel_energy\n  WHERE $__timeFilter(ts)\n    AND segment = 'cel'\n    AND direction = 'consumption'\n    AND meter_id LIKE '%$meter_id'\n  SAMPLE BY 15m\n)\nSAMPLE BY $__sampleByInterval FILL(NULL)\nORDER BY time",
          "refId": "A",
          "selectedFormat": 0,
          "promqlOriginal": "(avg_over_time(cel_energy_kwh{segment=\"cel\", direction=\"consumption\", meter_id=~\".*${meter_id}\"}[$__interval:15m])) * 4"
        },
        {
          "datasource": {
            "type": "questdb-questdb-datasource",
            "uid": "QuestDB"
          },
          "format": 0,
