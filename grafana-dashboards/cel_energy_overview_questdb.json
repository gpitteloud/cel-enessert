          "rawSql": "SELECT ts AS time, cast(sum(value) AS DOUBLE) AS \"Total Consumption\"\nFROM cel_energy\nWHERE $__timeFilter(ts)\n  AND segment = 'total'\n  AND direction = 'consumption'\n  AND meter_id LIKE '%$meter_id'\nSAMPLE BY $__sampleByInterval FILL(NULL)\nORDER BY time",
