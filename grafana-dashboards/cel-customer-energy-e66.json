          "queryType": "sql",
          "rawSql": "SELECT ts AS time, cast(avg(slot_kwh) * 4 AS DOUBLE) AS \"Net Energy (positive = producing more)\"\nFROM (\n  SELECT ts, sum(case when direction = 'production' then value else value * -1 end) AS slot_kwh\n  FROM cel_energy\n  WHERE $__timeFilter(ts)\n    AND segment in ('cel', 'grid')\n    AND customer_id = '$customer_id'\n  SAMPLE BY 15m\n)\nSAMPLE BY $__sampleByInterval FILL(NULL)\nORDER BY time",
