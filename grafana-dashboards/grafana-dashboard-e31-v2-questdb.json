        {
          "datasource": {
            "type": "questdb-questdb-datasource",
            "uid": "QuestDB"
          },
          "editorMode": "code",
          "format": "time_series",
          "meta": {
            "promql": "(avg_over_time(cel_community_energy_kwh{project=\"cel\", community_id=\"101110-002726\", product_code=\"2404050010123\", direction=\"consumption\"}[$__interval:15m])) * 4"
          },
          "queryType": "sql",
          "rawSql": "SELECT ts AS time, avg(slot_kwh) * 4 AS \"From CEL\"\nFROM (\n  SELECT ts, sum(value) AS slot_kwh\n  FROM cel_community_energy\n  WHERE $__timeFilter(ts)\n    AND community_id = '101110-002726'\n    AND segment = 'cel'\n    AND direction = 'consumption'\n  SAMPLE BY 15m\n)\nSAMPLE BY $__sampleByInterval FILL(NULL)\nORDER BY time",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "questdb-questdb-datasource",
            "uid": "QuestDB"
          },
          "editorMode": "code",
          "format": "time_series",
          "meta": {
            "promql": "(avg_over_time(cel_community_energy_kwh{project=\"cel\", community_id=\"101110-002726\", product_code=\"2404050010124\", direction=\"consumption\"}[$__interval:15m])) * 4"
          },
          "queryType": "sql",
          "rawSql": "SELECT ts AS time, avg(slot_kwh) * 4 AS \"From Grid\"\nFROM (\n  SELECT ts, sum(value) AS slot_kwh\n  FROM cel_community_energy\n  WHERE $__timeFilter(ts)\n    AND community_id = '101110-002726'\n    AND segment = 'grid'\n    AND direction = 'consumption'\n  SAMPLE BY 15m\n)\nSAMPLE BY $__sampleByInterval FILL(NULL)\nORDER BY time",
          "refId": "C"
        }
      ],
      "title": "Community Consumption Over Time",
      "type": "timeseries",
      "interval": "15m"
    }
